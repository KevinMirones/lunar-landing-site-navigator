{
  "name": "lumina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LUMINA - Lunar Mission Illumination & Network Analyzer",
  "scripts": {
    "fetch-data": "node scripts/fetch-data.mjs",
    "dev": "concurrently -k -n api,web -c cyan,yellow \"node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
